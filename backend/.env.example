# Application
APP_NAME=TestMate AI API
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# PostgreSQL (replace with local credentials; never commit a real .env file)
DATABASE_URL=postgresql+psycopg://testmate:testmate@localhost:5432/testmate_ai

# Comma-separated origins allowed to call the API in development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Requirement analysis (Phase 3)
# Active provider: "openai" or "gemini"
AI_PROVIDER=gemini

# Google Gemini API configuration (free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI API configuration (if using AI_PROVIDER=openai)
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Request timeout for requirement analysis calls in seconds
ANALYSIS_TIMEOUT_SECONDS=30

# Test Execution Engine (Phase 5)
TARGET_APP_URL=http://localhost:5173
TARGET_API_URL=http://localhost:8000/api/v1
APPROVED_API_HOSTS=localhost,127.0.0.1,testserver
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_SECONDS=15
HTTP_TIMEOUT_SECONDS=10
EVIDENCE_STORAGE_DIR=evidence_storage

# Historical Bug Intelligence / Qdrant (Phase 8)
# Operating mode: "server" (standalone instance), "local" (embedded disk directory), or "memory" (in-memory for tests)
QDRANT_MODE=server
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=testmate_historical_knowledge
QDRANT_LOCAL_PATH=qdrant_storage
QDRANT_TIMEOUT_SECONDS=5.0
QDRANT_VECTOR_SIZE=384

# Historical Bug Intelligence / Embedding Model (Phase 8.3)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# Historical Bug Intelligence / Semantic Retrieval (Phase 8.6)
KNOWLEDGE_RETRIEVAL_MIN_SCORE=0.4
KNOWLEDGE_RETRIEVAL_LIMIT=5
