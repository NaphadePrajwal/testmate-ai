# Application
APP_NAME=TestMate AI API
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# PostgreSQL (replace with local credentials; never commit a real .env file)
DATABASE_URL=postgresql+psycopg://testmate:testmate@localhost:5432/testmate_ai

# Comma-separated origins allowed to call the API in development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Requirement analysis (Phase 3)
# Active provider: "openai" or "gemini"
AI_PROVIDER=gemini

# Google Gemini API configuration (free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI API configuration (if using AI_PROVIDER=openai)
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Request timeout for requirement analysis calls in seconds
ANALYSIS_TIMEOUT_SECONDS=30
